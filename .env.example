# --- Required ---
GEMINI_API_KEY=your-key-here            # free at https://aistudio.google.com/apikey

# --- Django (production: set all of these) ---
DJANGO_SECRET_KEY=change-me             # long random string
DJANGO_DEBUG=true                       # false in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=            # e.g. https://your-app.hf.space
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ASK_RATE_LIMIT=20/min

# --- Web UI ---
PRODUCT_NAME=المرشد الأكاديمي الذكي
PRODUCT_NAME_EN=Smart Academic Advisor
SHOW_DEMO_ACCOUNTS=true                 # show demo logins on the login page (false for real users)
# DEMO_STUDENT_PASSWORD=student-demo-2026
# DEMO_ADMIN_PASSWORD=admin-demo-2026
# RAG_WARMUP=true                       # load AI models at server start (first answer is faster)

# --- Optional RAG tuning (defaults in rag/config.py) ---
# GEMINI_MODEL=gemini-3.5-flash         # tried first, before the built-in fallbacks
# RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# RAG_MAX_DIST=0.20
# RAG_TOP_K=6
# RAG_CHUNK_CHARS=900
